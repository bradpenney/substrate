[Unit]
Description=Nightly hypervisor updates (reboots only when required and safe)
Documentation=https://github.com/bradpenney/substrate
# This unit failed five nights running on server1 -- no updates applied, no
# reboot -- and nothing said so, because there was no OnFailure at all. Found by
# reading the journal for an unrelated reason. Added 2026-08-27; moved into this
# repo 2026-08-28, since deploy_updates.py would otherwise overwrite the live
# fix on the next run and restore the silence.
OnFailure=hypervisor-update-notify.service
After=network-online.target libvirtd.service
Wants=network-online.target
# Ordering only -- it does not stop the backup starting later, so the real
# protection is the interlock gate inside hypervisor-update.sh. This just means
# that when both are queued in one transaction, the backup goes first.
After=nextcloud-backup.service

[Service]
Type=oneshot
# PEER_HOST and KUBECONFIG_PATH come from here; written per-host by
# deploy-updates.sh since each hypervisor's peer is the other one.
EnvironmentFile=/etc/homelab/update.env
ExecStart=/usr/local/bin/hypervisor-update.sh
# Updates + drain + guest shutdown grace can legitimately take a while, and the
# backup interlock may now add up to BACKUP_WAIT_SECS (default 1800) on top.
TimeoutStartSec=5400
