[Unit]
Description=Uncordon this hypervisor's k0s nodes after boot
Documentation=https://github.com/bradpenney/substrate
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/homelab/update.env
ExecStart=/usr/local/bin/hypervisor-uncordon.sh
# Waits for the control plane to come back, which after a host reboot can take
# a few minutes.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
