[Unit]
Description=Announce that %i failed
Documentation=https://github.com/bradpenney/substrate
# Templated, so one unit covers every observability service rather than one
# notifier each. %i is the failing unit's name, passed by OnFailure=%n.
#
# ⚠️ OnFailure= belongs in the FAILING unit's [Unit] section. Put in [Service]
# it is silently ignored — no error, no notification, and the first evidence is
# a service that has been dead for days. That has already happened here once.

[Service]
Type=oneshot
# RATE LIMIT, added 2026-09-02. A crash-looping service with RestartSec=5s
# triggers OnFailure= on EVERY attempt, and this template had no bound: one
# permanently-broken unit sent 9 push notifications in 20 minutes and would have
# continued indefinitely. An alert that repeats every five seconds is not more
# informative than one that arrives once; it is less, because it buries every
# other alert.
#
# ExecCondition SKIPS the unit when it exits non-zero — the notifier is not
# marked failed, it simply does not fire. The stamp lives in /run (tmpfs), so a
# reboot legitimately re-alerts rather than staying silent about a fault that
# survived it.
ExecCondition=/bin/bash -c 'stamp=/run/observability-notify-%i; \
    if [ -e "$stamp" ] && [ $(( $(date +%%s) - $(stat -c %%Y "$stamp") )) -lt 900 ]; then exit 1; fi; \
    touch "$stamp"'
# Same notifier the hypervisor units use. One channel for host-tier failures,
# so a new one does not have to be discovered separately.
ExecStart=/usr/local/bin/homelab-notify.sh "Observability: %i failed" \
    "systemctl status %i on server1"
