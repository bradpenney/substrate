[Unit]
Description=VictoriaMetrics (metrics store and scraper)
Documentation=https://github.com/bradpenney/substrate
# Chosen over Prometheus on measured grounds (ADR-096): server2's three nodes
# have ~2.4 Gi of schedulable memory BETWEEN them once the ADR-064 reservation
# is taken. This runs on the HOST tier instead, so that constraint no longer
# binds it — but the reason it was chosen still holds for the agents.
# %p, not %n: %n expands to the FULL unit name INCLUDING the .service
# suffix, so `@%n.service` produced observability-notify@node-exporter
# .service.service — which systemd loads, so nothing complained.
# WHY THIS IS A SYSTEMD UNIT AND NOT A DEPLOYMENT
# The PRINCIPLE: observability lives outside the rebuildable unit. The observer
# must not share a failure domain — or a LIFECYCLE — with the observed, and
# `gate.py rebuild` destroys this cluster deliberately and routinely.
# The metrics store has to outlive that, and be able to watch it happen.
#
# The COMPROMISE: it runs on a hypervisor because there is no second cluster to
# put it on. Ideally this would be separate infrastructure-grade hardware with
# its own failure domain. It is not — so if this host dies, observability dies
# with it. That is a resource constraint, not the design (ADR-098).
#
# Moving it later is: change one address in the in-cluster agents. The boundary
# is the architecture; this machine is an annotation on it.
OnFailure=observability-notify@%p.service
After=network-online.target
Wants=network-online.target

# Restart forever. StartLimitIntervalSec/StartLimitBurst live in [Unit], NOT
# [Service] — systemd silently ignores them there ("Unknown key ... ignoring"),
# which would leave the default of "give up after 5 restarts in 10 seconds" in
# force while the file appeared to say otherwise. Exactly the same class of
# defect as OnFailure= in [Service]. Caught by `systemd-analyze verify`, which
# is now part of the test suite.
StartLimitIntervalSec=0

[Service]
# CORRECTED 2026-09-02. This previously bound 127.0.0.1 only, above a comment
# claiming the in-cluster vmagent "pushes to the separate remote-write listener,
# which the installer opens to the cluster CIDRs alone".
#
# There is no separate listener. Single-node VictoriaMetrics serves
# /api/v1/write on this same -httpListenAddr; there is no second port and the
# installer opened nothing for one. So ADR-098's cluster tier — vmagent
# remote_writing cluster metrics to the host — had no reachable destination and
# could never have worked. The sentence sounded right and was never tested
# against a running vmagent, because there was not one yet.
#
# Now bound on all interfaces, with firewalld allow-listing 8428 to the five k0s
# node addresses alone (deploy-observability.py), the same shape already used
# for 9428. Grafana still reaches it over loopback, which :8428 includes.
#
# KNOWN TRADE-OFF, stated rather than discovered later: the write path and the
# QUERY path share this port, and VictoriaMetrics has no per-path authorisation.
# The firewall allow-list is therefore the only thing standing between a node
# and the ability to read or delete series. It must stay an allow-list of node
# addresses — never a LAN range.
# -promscrape.configCheckInterval is NOT optional decoration. Checking is
# DISABLED by default ("By default, the checking is disabled"), so without it the
# scrape config is read exactly ONCE, at start, and a deploy that rewrites
# scrape.yml leaves this process scraping the previous config indefinitely. Found
# 2026-09-03 with 18 hours of drift: the file on disk carried the new host
# labels, the running scraper did not, and both the deploy and the drift check
# reported a match (ADR-118, ADR-122).
#
# A reload rather than a restart, deliberately: this unit stops with SIGINT
# precisely so VictoriaMetrics flushes its in-memory parts, and bouncing the
# store to pick up a label is a gap in every graph on the dashboard.
#
# NB comments cannot go inside the continued ExecStart below -- systemd passes
# them through as arguments rather than treating them as comments.
ExecStart=/usr/local/bin/victoria-metrics-prod \
    -storageDataPath=/var/lib/victoria-metrics \
    -httpListenAddr=:8428 \
    -promscrape.config=/etc/victoria-metrics/scrape.yml \
    -promscrape.configCheckInterval=30s \
    -retentionPeriod=6 \
    -memory.allowedPercent=25 \
    -loggerFormat=json
Restart=always
RestartSec=5s

# SIGINT, not SIGTERM: VictoriaMetrics flushes its in-memory parts on SIGINT.
# SIGTERM loses the most recent, unflushed data on every restart — a slow leak
# of exactly the datapoints most likely to be interesting.
KillSignal=SIGINT
TimeoutStopSec=60

User=victoriametrics
Group=victoriametrics
StateDirectory=victoria-metrics
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
