# Ansible lives in a repo-local venv (see ansible/README rationale in site.yml).
# It's ~57MB of third-party code — recreate it, don't commit it:
#   python3 -m venv .venv && .venv/bin/pip install ansible-core
.venv/

__pycache__/
*.pyc

# Saved cluster end-state snapshots from `gate.py rebuild`. Machine-local
# evidence from a specific run, not source — and they go stale the moment the
# cluster is rebuilt.
.fingerprints/

# Ansible retry files
*.retry

# Real site configuration: addresses, usernames, storage layout.
# Committed template is site.example.yml — this file never goes to git.
# ANCHORED to the repo root. A bare `site.yml` matches at ANY depth, which
# silently excluded tests/fixtures/site.yml — the synthetic config the whole
# suite depends on — so CI failed on its first run with "No site
# configuration found". The real site.yml still must never be committed.
/site.yml
.dns-migration.env

# pytest / coverage artefacts. All REGENERATED by every run, so tracking them
# means every commit carries a diff that says nothing about the change.
# check_coverage.py reads the runner's own coverage.json; nothing needs a
# committed copy.
.coverage
coverage.json
logic-coverage.txt
tests/__pycache__/
.pytest_cache/
